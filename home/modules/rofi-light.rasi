* {
    bg:     #ffffff;
    bg-alt: #f5f5f5;
    fg:     #000000;
    border: #d0d0d0;
    sel:    #e8e8e8;
    muted:  #999999;
    accent: #000000;

    background-color: @bg;
    text-color:       @fg;
    border-color:     @border;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @border;
    border-radius:    0;
    padding:          8px;
    width:            640px;
}

mainbox {
    background-color: transparent;
    spacing:          8px;
    padding:          0;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border;
    border-radius:    0;
    padding:          8px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder-color: @muted;
    cursor:           text;
}

listview {
    background-color: transparent;
    border:           0;
    padding:          0;
    lines:            8;
    columns:          1;
    spacing:          4px;
    scrollbar:        false;
}

element {
    background-color: @bg-alt;
    text-color:       @fg;
    border:           1px;
    border-color:     @border;
    border-radius:    0;
    padding:          6px 8px;
    spacing:          8px;
}

element-icon {
    background-color: transparent;
    size:             1.2em;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element selected {
    background-color: @sel;
    text-color:       @fg;
    border-color:     @accent;
}
