package templates

templ Posts(posts []BlogPost) {
	@Base("Posts — Roberto Castellotti") {
		<h1>posts</h1>
			<ul class="posts">
				for _, post := range posts {
					<li>
						<h2><a href={ templ.SafeURL("/posts/" + post.Slug) }>{ post.Title }</a></h2>
						if !post.Date.IsZero() {
							<time datetime={ post.Date.Format("2006-01-02") }>{ post.Date.Format("02 Jan 2006") }</time>
						}
					</li>
				}
			</ul>
	}
}

templ Post(post BlogPost) {
	@Base(post.Title + " — Roberto Castellotti") {
		<article>
			<header>
				<h1>{ post.Title }</h1>
				if !post.Date.IsZero() {
					<time datetime={ post.Date.Format("2006-01-02") }>{ post.Date.Format("02 Jan 2006") }</time>
				}
			</header>
			@templ.Raw(post.HTML)
		</article>
	}
}
